# ===== OpenAI =====
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# ===== SMAIPL (Function #181) =====
# ВАЖНО: сюда вставишь реальный endpoint SMAIPL, который вызывает функцию/tool.
# Пример (условный): https://api.smaipl.com/v1/tools/call
SMAIPL_ENDPOINT=https://<your-smaipl-endpoint>
SMAIPL_API_KEY=your_smaipl_key

# Если SMAIPL требует другой заголовок авторизации — поправим в integrations/smaipl.py
SMAIPL_AUTH_HEADER=Authorization
SMAIPL_AUTH_PREFIX=Bearer

# ===== Google Doc target =====
GOOGLE_DOC_URL=https://docs.google.com/document/d/<DOC_ID>/edit

# ===== Summary behavior =====
SUMMARY_MAX_BULLETS=12
SUMMARY_MIN_BULLETS=5
SUMMARY_LANGUAGE=ru

# ===== Service =====
PORT=8000
